# Copy this file to `.env` and adjust values as needed.
# Docker Compose uses these variables directly.
# For local `dotnet run`, change `Host=postgres/minio/redis` to `Host=localhost`.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=latex_renderer

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# App
ConnectionStrings__DefaultConnection=Host=postgres;Database=latex_renderer;Username=postgres;Password=postgres
Minio__Endpoint=minio:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Redis__ConnectionString=redis:6379

# File storage (Local | S3)
# For local `dotnet run` with MinIO from docker compose, use:
#   Storage__Provider=S3
#   Storage__S3ServiceUrl=http://localhost:9000
Storage__Provider=Local
Storage__LocalRootPath=storage
Storage__S3Bucket=latex-renderer
Storage__S3ServiceUrl=http://minio:9000
# Public URL used for presigned URLs (reachable from your browser/host)
Storage__S3PublicUrl=http://localhost:9000
# Signing region: use "auto" for Cloudflare R2, leave empty for MinIO
Storage__S3Region=
Storage__S3AccessKey=minioadmin
Storage__S3SecretKey=minioadmin

# OAuth (optional; leave empty to disable external login providers)
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=
