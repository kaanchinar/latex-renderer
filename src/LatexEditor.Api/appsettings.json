{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage"
  },
  "Tectonic": {
    "ExecutablePath": "tectonic",
    "TimeoutSeconds": 60
  },
  "RateLimiting": {
    "CompilePermitLimit": 5,
    "CompileWindowSeconds": 60
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "FromAddress": "noreply@example.com",
    "UseSsl": true
  }
}
